# Kopyahin ito bilang ".env" at ilagay ang values mula sa Firebase Console
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region ng Cloud Functions (Singapore = pinakamalapit sa PH)
VITE_FUNCTIONS_REGION=asia-southeast1

# EMULATOR MODE (walang Blaze): gawing "true" at patakbuhin: firebase emulators:start --project demo-orderqr
# Sa emulator mode, dummy lang ang values sa taas; dapat lang PROJECT_ID = demo-orderqr
VITE_USE_EMULATOR=false
